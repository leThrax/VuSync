{
  "name": "vusync",
  "version": "1.0.0",
  "description": "A modern self-hosting Youtube synchronizer built with React + Vite and Nodes.js + Express",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "start": "NODE_ENV=production node server/dist/index.js",
    "admin:hash-password": "node -e \"const b=require('bcryptjs');const p=process.argv[1];if(!p){console.error('Usage: npm run admin:hash-password -- <password>');process.exit(1)}console.log(b.hashSync(p,12))\""
  },
  "keywords": [],
  "author": "Thrax",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
